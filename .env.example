OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
DATA_DIR=./data
# Local, single-user app. Set a strong token before serving beyond localhost.
APP_TOKEN=
# Google OAuth authorised-user JSON, or service-account JSON (use a Shared Drive).
GOOGLE_CREDENTIALS_FILE=
DROPBOX_ACCESS_TOKEN=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Exact HTTPS hosts for other direct-download document URLs; no credentials sent.
ALLOWED_DOWNLOAD_HOSTS=
# Optional worker: checks configured projects while the app is running. 0 disables it.
POLL_SECONDS=0

# Add your hostname for a hosted deployment; localhost defaults are allowed.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
